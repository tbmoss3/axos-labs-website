# Axos Labs Website — Environment Variables

# ── Discord Webhook (intake form) ──
DISCORD_WEBHOOK_URL=

# ── PostgreSQL Database ──
# Railway injects this automatically when you add a Postgres database.
# Example: postgresql://postgres:password@containers.railway.app:1234/axos
DATABASE_URL=

# ── Clerk Authentication (optional — portal page works without it) ──
# If set, portal page will show Sign In button. If not set, portal is open.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/portal
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/portal
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/portal
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/portal
